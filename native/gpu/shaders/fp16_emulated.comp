#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
  vec4 values[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
  vec4 values[];
} output_buffer;

layout(push_constant) uniform Parameters {
  uint output_offset;
  uint reserved;
} parameters;

void main() {
  const uint index = gl_GlobalInvocationID.x;
  const vec4 seed = input_buffer.values[index];
  vec4 a0 = seed + vec4(0.101);
  vec4 a1 = seed + vec4(0.113);
  vec4 a2 = seed + vec4(0.139);
  vec4 a3 = seed + vec4(0.163);
  vec4 a4 = seed + vec4(0.181);
  vec4 a5 = seed + vec4(0.199);
  vec4 a6 = seed + vec4(0.229);
  vec4 a7 = seed + vec4(0.251);
  const vec4 multiplier = vec4(0.0009765625);

  // Same algorithm and operation count as native FP16, executed with FP32.
  for (uint iteration = 0; iteration < 64; ++iteration) {
    a0 = fma(a0, multiplier, a4);
    a1 = fma(a1, multiplier, a5);
    a2 = fma(a2, multiplier, a6);
    a3 = fma(a3, multiplier, a7);
    a4 = fma(a4, multiplier, a1);
    a5 = fma(a5, multiplier, a2);
    a6 = fma(a6, multiplier, a3);
    a7 = fma(a7, multiplier, a0);
  }

  output_buffer.values[index] =
      (a0 + a1) + (a2 + a3) + (a4 + a5) + (a6 + a7);
}
