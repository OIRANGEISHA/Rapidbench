#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
  vec4 values[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
  vec4 values[];
} output_buffer;

layout(push_constant) uniform Parameters {
  uint output_offset;
  uint reserved;
} parameters;

void main() {
  const uint index = gl_GlobalInvocationID.x;
  const f16vec4 seed = f16vec4(input_buffer.values[index]);
  f16vec4 a0 = seed + f16vec4(0.101);
  f16vec4 a1 = seed + f16vec4(0.113);
  f16vec4 a2 = seed + f16vec4(0.139);
  f16vec4 a3 = seed + f16vec4(0.163);
  f16vec4 a4 = seed + f16vec4(0.181);
  f16vec4 a5 = seed + f16vec4(0.199);
  f16vec4 a6 = seed + f16vec4(0.229);
  f16vec4 a7 = seed + f16vec4(0.251);
  f16vec4 a8 = seed + f16vec4(0.277);
  f16vec4 a9 = seed + f16vec4(0.293);
  f16vec4 a10 = seed + f16vec4(0.317);
  f16vec4 a11 = seed + f16vec4(0.347);
  const f16vec4 multiplier = f16vec4(0.9990234375);

  // Same independent-chain structure and operation count as FP32-12.
  for (uint iteration = 0; iteration < 64; ++iteration) {
    a0 = fma(a0, multiplier, f16vec4(0.0009765625));
    a1 = fma(a1, multiplier, f16vec4(0.001953125));
    a2 = fma(a2, multiplier, f16vec4(0.0029296875));
    a3 = fma(a3, multiplier, f16vec4(0.00390625));
    a4 = fma(a4, multiplier, f16vec4(0.0048828125));
    a5 = fma(a5, multiplier, f16vec4(0.005859375));
    a6 = fma(a6, multiplier, f16vec4(0.0068359375));
    a7 = fma(a7, multiplier, f16vec4(0.0078125));
    a8 = fma(a8, multiplier, f16vec4(0.0087890625));
    a9 = fma(a9, multiplier, f16vec4(0.009765625));
    a10 = fma(a10, multiplier, f16vec4(0.0107421875));
    a11 = fma(a11, multiplier, f16vec4(0.01171875));
  }

  output_buffer.values[parameters.output_offset + index] = vec4(
      ((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7)) +
      ((a8 + a9) + (a10 + a11)));
}
