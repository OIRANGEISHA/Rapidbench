#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
  vec4 values[];
} input_buffer;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
  vec4 values[];
} output_buffer;

layout(push_constant) uniform Parameters {
  uint output_offset;
  uint reserved;
} parameters;

void main() {
  const uint index = gl_GlobalInvocationID.x;
  const f16vec4 seed = f16vec4(input_buffer.values[index]);
  f16vec4 a0 = seed + f16vec4(0.101);
  f16vec4 a1 = seed + f16vec4(0.113);
  f16vec4 a2 = seed + f16vec4(0.139);
  f16vec4 a3 = seed + f16vec4(0.163);
  f16vec4 a4 = seed + f16vec4(0.181);
  f16vec4 a5 = seed + f16vec4(0.199);
  f16vec4 a6 = seed + f16vec4(0.229);
  f16vec4 a7 = seed + f16vec4(0.251);
  const f16vec4 multiplier = f16vec4(0.0009765625);

  // The workload exactly mirrors FP32, but every timed FMA is native FP16.
  for (uint iteration = 0; iteration < 64; ++iteration) {
    a0 = fma(a0, multiplier, a4);
    a1 = fma(a1, multiplier, a5);
    a2 = fma(a2, multiplier, a6);
    a3 = fma(a3, multiplier, a7);
    a4 = fma(a4, multiplier, a1);
    a5 = fma(a5, multiplier, a2);
    a6 = fma(a6, multiplier, a3);
    a7 = fma(a7, multiplier, a0);
  }

  output_buffer.values[index] =
      vec4((a0 + a1) + (a2 + a3) + (a4 + a5) + (a6 + a7));
}
